# Copy to .env.local (or set these in your hosting dashboard). Never commit real values.

# --- Admin dashboard (/admin) ---
# Make both lines with:  npm run admin:hash
# ADMIN_PASSWORD_HASH is a scrypt hash, never the password itself. Changing it signs everyone out.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# --- Vercel Blob (admin content and uploaded videos) ---
# Set automatically when a Blob store is connected to the project in Vercel
# (Storage → Blob). Without it, production can't save; development saves to .data/.
BLOB_READ_WRITE_TOKEN=

# --- Website chat ("Kitty", /api/support) ---
# Claude API key from https://console.anthropic.com. Without it the chat stays up
# and sends people to WhatsApp instead of answering.
ANTHROPIC_API_KEY=

# --- Google Analytics 4 (optional) ---
NEXT_PUBLIC_GA_ID=

# --- M-Pesa via Safaricom Daraja (M-Pesa Express / STK Push) ---
# Online payments switch on by themselves once the KEY, SECRET, PASSKEY, SHORTCODE,
# CALLBACK_BASE and CALLBACK_TOKEN are all set. Until then customers are told the
# payment details come on WhatsApp.

# "sandbox" for testing, "production" when going live.
DARAJA_ENV=sandbox

# From your app at https://developer.safaricom.co.ke (My Apps).
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=

# "paybill" or "till".
DARAJA_TYPE=paybill

# Paybill: your paybill number. Till: the head-office (store) number linked to the till.
# Sandbox test shortcode: 174379
DARAJA_SHORTCODE=

# Till only: the till number customers pay (Buy Goods). Leave empty for a paybill.
DARAJA_TILL=

# The Lipa na M-Pesa Online passkey Safaricom emails you when you go live.
# Sandbox passkey is on the Daraja simulator page for shortcode 174379.
DARAJA_PASSKEY=

# Public https address of the live site. Safaricom posts payment results to
# <this>/api/payments/hook/<DARAJA_CALLBACK_TOKEN>.
DARAJA_CALLBACK_BASE=https://mysweetkitty.com

# A long random secret (at least 16 characters) that keeps fake results out.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DARAJA_CALLBACK_TOKEN=
